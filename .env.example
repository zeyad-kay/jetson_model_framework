# Copy to .env and fill in HF_TOKEN:  cp .env.example .env
# Hugging Face token (https://huggingface.co/settings/tokens); its account needs access to facebook/sam3.
HF_TOKEN=

# --- shared by every service ---
# Audio sample rate (Hz), read by the server and the ASR service.
SAMPLING_RATE=16000
LOG_LEVEL=INFO
# Container paths. Compose mounts ./sessions, ./logs and ./run at these.
SESSIONS_DIR=/sessions
# Each service writes <LOGS_DIR>/<name>.log: server, asr, llm_extraction, video.
LOGS_DIR=/logs
# Each model service writes its heartbeat to <STATUS_DIR>/<service>.json (asr_service,
# llm_extraction_service, video_service), which the server reads.
STATUS_DIR=/run/status

# --- server ---
SERVER_COMMAND_HOST=0.0.0.0
SERVER_COMMAND_PORT=8000
SERVER_MONITOR=true
# Seconds between checks of the services' heartbeats, and how old a heartbeat may be for its service to count as up.
SERVER_MONITOR_INTERVAL=20
SERVER_STATUS_TIMEOUT=15
SERVER_MEDIA_API_URL=http://127.0.0.1:9997
SERVER_MEDIA_RTSP_URL=rtsp://127.0.0.1:8554
# The MediaMTX binary (relative to the working dir) and the config it runs with.
SERVER_MEDIA_BINARY=mediamtx/mediamtx
SERVER_MEDIA_CONFIG=/app/server/mediamtx.yml

# --- asr_service ---
ASR_LANGUAGE=en-US
ASR_DELAY=2
ASR_NUM_LOOKAHEAD_TOKENS=6
ASR_POLL_INTERVAL=0.05
ASR_SEGMENT_PAUSE=20
ASR_SEGMENT_MIN_LENGTH=20

# --- llm_extraction_service ---
# Hugging Face id of the per-segment extraction model.
LLM_EXTRACTION_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Seconds between checks for new segments.
LLM_EXTRACTION_POLL_INTERVAL=0.5
# Seconds segments.json must stay unchanged after a session ends before extraction
# stops; must exceed the ASR's end-of-session drain.
LLM_EXTRACTION_DRAIN_IDLE=30
# Attach ATC / ICD-10-PCS codes to extracted entities. Needs the code index in
# llm_extraction_service/terminology/index.
LLM_EXTRACTION_LINK=true

# --- video_service ---
# Text prompt naming what SAM 3 segments.
VIDEO_PROMPT=wound
VIDEO_IDLE_TIMEOUT=10
VIDEO_DRAIN_IDLE=1
VIDEO_PROBE_TIMEOUT=60
VIDEO_MIN_SCORE=0.9
VIDEO_JPEG_QUALITY=90
VIDEO_POLL_INTERVAL=0.05

# --- dashboard ---
# Address and port the web dashboard is served on (http://<jetson-ip>:8080/).
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# A session shows as live while it hasn't ended and one of its files changed within this many seconds.
DASHBOARD_LIVE_WINDOW=120
